APP_ALLOWED_ORIGIN=*

MYSQL_HOST=sqlXXX.infinityfree.com
MYSQL_PORT=3306
MYSQL_USER=if0_xxxxxxxx
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=if0_xxxxxxxx_guvi_project

# External Mongo profile API URL. Required because InfinityFree cannot run ext-mongodb.
# Example after Render deployment: https://guvi-profile-api.onrender.com
MONGO_API_BASE_URL=

UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

SESSION_TTL_SECONDS=86400
